{
  "name": "live-p5",
  "displayName": "live-p5",
  "description": "Edit your p5 code live, without reloading",
  "version": "1.5.0",
  "author": {
    "name": "filipesabella"
  },
  "publisher": "filipesabella",
  "engines": {
    "vscode": "^1.138.0"
  },
  "keywords": [
    "p5",
    "live",
    "auto-reload"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/extension.js",
    "assets/p5.min.js",
    "assets/p5.sound.min.js",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "extension.live-p5",
        "title": "Open live p5 panel"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./ && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --minify",
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap --watch",
    "test": "vitest run",
    "test-watch": "vitest",
    "package": "vsce package --no-yarn",
    "release": "vsce publish --no-yarn",
    "fmt": "dprint fmt",
    "check": "tsc -p ./ && dprint check",
    "update-p5": "node scripts/update-p5.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "^1.138.0",
    "@vscode/vsce": "^4.0.0",
    "dprint": "^0.57.4",
    "esbuild": "^0.28.2",
    "node-html-markdown": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "recast": "^0.24.0",
    "sucrase": "^3.35.1"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/filipesabella/vscode-live-p5/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/filipesabella/vscode-live-p5.git"
  },
  "homepage": "https://github.com/filipesabella/vscode-live-p5/blob/master/README.md"
}
