{
  "name": "live-p5",
  "displayName": "live-p5",
  "description": "Edit your p5 code live, without reloading",
  "version": "1.5.0",
  "author": {
    "name": "filipesabella"
  },
  "publisher": "filipesabella",
  "engines": {
    "vscode": "^1.138.0"
  },
  "keywords": [
    "p5",
    "live",
    "auto-reload"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension",
  "files": [
    "out/src/**/*.js",
    "assets",
    "node_modules",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "extension.live-p5",
        "title": "Open live p5 panel"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -watch -p ./",
    "test": "vitest run",
    "test-watch": "vitest",
    "package": "vsce package --no-yarn",
    "release": "vsce publish --no-yarn"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/p5": "^1.7.7",
    "@types/vscode": "^1.138.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "recast": "^0.24.0",
    "sucrase": "^3.35.1"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/filipesabella/vscode-live-p5/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/filipesabella/vscode-live-p5.git"
  },
  "homepage": "https://github.com/filipesabella/vscode-live-p5/blob/master/README.md"
}
